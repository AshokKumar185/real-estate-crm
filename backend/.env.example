PORT=4000
FRONTEND_URL=http://localhost:3000
# Set DATABASE_URL for hosted PostgreSQL providers such as Neon.
# Leave it empty locally to use the PG* variables below.
DATABASE_URL=
PGHOST=localhost
PGPORT=5433
PGDATABASE=real_estate_crm
PGUSER=postgres
PGPASSWORD=replace-locally
JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info
LOG_SQL=false
# Set true for the first deployment only; seed runs only when the database has no users.
SEED_ON_START=false
